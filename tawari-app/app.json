{
  "expo": {
    "name": "أرقام الطوارئ",
    "slug": "tawari-app",
    "scheme": "tawari",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F8FA",
    "primaryColor": "#E63946",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tawari.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "التطبيق يحتاج موقعك عشان يقدر يرسله لجهة الطوارئ اللي تتصل بيها أو تشاركه مع جهات اتصالك.",
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.tawari.app",
      "adaptiveIcon": {
        "backgroundColor": "#E63946",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FA"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "التطبيق يحتاج موقعك عشان يقدر يرسله لجهة الطوارئ اللي تتصل بيها أو تشاركه مع جهات اتصالك."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "التطبيق يحتاج الميكروفون عشان يسمع بلاغك ويحدد نوع الطارئة بصوتك.",
          "speechRecognitionPermission": "التطبيق يحتاج التعرف على الصوت عشان يحول كلامك لبلاغ."
        }
      ]
    ]
  }
}
